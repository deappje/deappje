"""deappje — a basable nanoservice application.

Rendered by the basable scaffolder (crates 0.8.0, template
v0.8.0). Bazel + rules_rust is the only build; the Cargo.toml
files are package metadata for crate_universe. Dependencies are declared in the
workspace Cargo.toml and repinned with `CARGO_BAZEL_REPIN=workspace`, which
.basable/verify.sh and the CI export (docs/adding-a-dependency.md).
"""

module(
    name = "deappje",
    version = "0.1.0",
)

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_multirun", version = "0.14.0")
bazel_dep(name = "rules_buf", version = "0.5.4")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# protoc comes prebuilt from this module's own toolchains (.bazelrc sets
# prefer_prebuilt_protoc): nothing compiles protobuf's C++.
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "bazel_lib", version = "3.7.0")

# --- Rust toolchain --------------------------------------------------------
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = [
        "x86_64-unknown-linux-gnu",
        # The client core (docs/01-deappje/05-deployment.md, "The apps"):
        # the two Android ABIs, the two iOS platforms and the web. A build
        # for one of them happens only behind --//:apps or from the web
        # client's wasm target; the server never selects them.
        "aarch64-linux-android",
        "x86_64-linux-android",
        "aarch64-apple-ios",
        "aarch64-apple-ios-sim",
        "wasm32-unknown-unknown",
    ],
    versions = ["1.98.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# --- Crates (crate_universe from the workspace Cargo.toml) ------------------
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:Cargo.Bazel.lock",
    manifests = [
        "//:Cargo.toml",
        "//crates/proto:Cargo.toml",
        "//crates/messages:Cargo.toml",
        "//crates/interfaces:Cargo.toml",
        "//crates/messenger:Cargo.toml",
        "//api:Cargo.toml",
        "//app:Cargo.toml",
        # basable:manifests-begin — one line per nanoservice crate
        "//nanoservices/group:Cargo.toml",
        "//nanoservices/device:Cargo.toml",
        "//nanoservices/relay:Cargo.toml",
        "//nanoservices/storage:Cargo.toml",
        # basable:manifests-end
    ],
)

# The codegen binaries the genrules run: the messenger generator over
# routing.yaml and the two protoc plugins (buffa messages and views, the
# connect-rust service stubs).
crate.annotation(
    crate = "basable-messenger-gen",
    gen_binaries = ["basable-messenger-gen"],
    # The server's hub only: the core's graph has no codegen binary.
    repositories = ["crates"],
)
crate.annotation(
    crate = "basable-protoc-gen-buffa",
    gen_binaries = ["protoc-gen-buffa"],
    # The server's hub only: the core's graph has no codegen binary.
    repositories = ["crates"],
)
crate.annotation(
    crate = "connectrpc-codegen",
    gen_binaries = ["protoc-gen-connect-rust"],
    # The server's hub only: the core's graph has no codegen binary.
    repositories = ["crates"],
)

# The client core's own hub (core/Cargo.toml says why it is apart): resolved
# for every triple it is built for, so a dependency that does not build for
# wasm or a phone is refused at the pin, not at the first app build.
crate.from_cargo(
    name = "core_crates",
    cargo_lockfile = "//core:Cargo.lock",
    lockfile = "//core:Cargo.Bazel.lock",
    manifests = ["//core:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
        "aarch64-linux-android",
        "x86_64-linux-android",
        "aarch64-apple-ios",
        "aarch64-apple-ios-sim",
    ],
)

# The binding generator's own hub (core/tools/bindgen): uniffi with its
# `cli` feature, which Cargo would otherwise unify into the core's own
# uniffi and so into every phone build. Host only.
# uniffi_bindgen's metadata-only compile and its full compile do not agree
# on the crate hash (the generator fails to link with E0460 under the
# repository's pipelined compilation), so it is compiled once.
crate.annotation(
    crate = "uniffi_bindgen",
    disable_pipelining = True,
    repositories = ["bindgen_crates"],
)
crate.from_cargo(
    name = "bindgen_crates",
    cargo_lockfile = "//core/tools/bindgen:Cargo.lock",
    lockfile = "//core/tools/bindgen:Cargo.Bazel.lock",
    manifests = ["//core/tools/bindgen:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
    ],
)
use_repo(crate, "bindgen_crates", "core_crates", "crates")

# --- buf (lint and breaking checks; codegen is protoc's) --------------------
buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")
buf.toolchains(version = "v1.73.0")
use_repo(buf, "rules_buf_toolchains")

register_toolchains("@rules_buf_toolchains//:all")

# --- The React frontend (rules_js) ------------------------------------------
# The npm graph is frontend/react/pnpm-lock.yaml; `@pnpm` is the pnpm that
# refreshes it (frontend/react/README.md).
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.17.0")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//frontend/react:pnpm-lock.yaml",
)
use_repo(npm, "npm")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
use_repo(pnpm, "pnpm")

# --- Base images (digest-pinned; a tag would move under the project) --------
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

# gcr.io/distroless/cc-debian13:nonroot
oci.pull(
    name = "distroless_cc",
    digest = "sha256:e792ab3d241a468a4fd7519ddbbebe66b49b5f365771716ea688ad40b6c6f1c2",
    image = "gcr.io/distroless/cc-debian13",
    platforms = ["linux/amd64"],
)

# ghcr.io/amacneil/dbmate:2.36.0
oci.pull(
    name = "dbmate",
    digest = "sha256:520c740c6e0ad73fde2cd1ea7e2b779aaf789d22aca8858f87a478e7094535fb",
    image = "ghcr.io/amacneil/dbmate",
    platforms = ["linux/amd64"],
)
use_repo(oci, "dbmate", "dbmate_linux_amd64", "distroless_cc", "distroless_cc_linux_amd64")

# --- The apps (docs/01-deappje/05-deployment.md, "The apps") ----------------
# Loaded here, used nowhere the scaffold's `bazel test //...` reaches: every
# target under ios/ and android/ and every non-host build of core/ is
# incompatible unless --//:apps is set (BUILD.bazel, `//:apps_on`), so the
# server builds with no Xcode and no ANDROID_HOME. apps.yaml is where these
# modules do work.
bazel_dep(name = "apple_support", version = "2.11.0")
bazel_dep(name = "rules_swift", version = "4.2.2")
bazel_dep(name = "rules_apple", version = "5.3.1")
bazel_dep(name = "rules_kotlin", version = "2.4.21")
bazel_dep(name = "rules_android", version = "0.8.0")
bazel_dep(name = "rules_android_ndk", version = "0.1.5")
bazel_dep(name = "rules_jvm_external", version = "7.2")

# The web client's build of the core: wasm32 plus wasm-bindgen's glue. Not
# behind --//:apps: a core that does not compile to wasm fails CI, as the
# plan asks (03-testing.md).
bazel_dep(name = "rules_rust_wasm_bindgen", version = "0.74.0")
