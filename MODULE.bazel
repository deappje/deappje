"""deappje — a basable nanoservice application.

Rendered by the basable scaffolder (crates 0.8.0, template
v0.8.0). Bazel + rules_rust is the only build; the Cargo.toml
files are package metadata for crate_universe. Dependencies are declared in the
workspace Cargo.toml and repinned with `CARGO_BAZEL_REPIN=workspace`, which
.basable/verify.sh and the CI export (docs/adding-a-dependency.md).
"""

module(
    name = "deappje",
    version = "0.1.0",
)

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_multirun", version = "0.14.0")
bazel_dep(name = "rules_buf", version = "0.5.4")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# protoc comes prebuilt from this module's own toolchains (.bazelrc sets
# prefer_prebuilt_protoc): nothing compiles protobuf's C++.
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "bazel_lib", version = "3.7.0")

# --- Rust toolchain --------------------------------------------------------
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = [
        "x86_64-unknown-linux-gnu",
        # The client core (docs/01-deappje/05-deployment.md, "The apps"):
        # the two Android ABIs, the two iOS platforms and the web. A build
        # for one of them happens only behind --//:apps or from the web
        # client's wasm target; the server never selects them.
        "aarch64-linux-android",
        "x86_64-linux-android",
        "aarch64-apple-ios",
        "aarch64-apple-ios-sim",
        "wasm32-unknown-unknown",
    ],
    versions = ["1.98.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# --- Crates (crate_universe from the workspace Cargo.toml) ------------------
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:Cargo.Bazel.lock",
    manifests = [
        "//:Cargo.toml",
        "//crates/proto:Cargo.toml",
        "//crates/messages:Cargo.toml",
        "//crates/interfaces:Cargo.toml",
        "//crates/messenger:Cargo.toml",
        "//api:Cargo.toml",
        "//app:Cargo.toml",
        # basable:manifests-begin — one line per nanoservice crate
        "//nanoservices/group:Cargo.toml",
        "//nanoservices/device:Cargo.toml",
        "//nanoservices/relay:Cargo.toml",
        "//nanoservices/storage:Cargo.toml",
        # basable:manifests-end
    ],
)

# The codegen binaries the genrules run: the messenger generator over
# routing.yaml and the two protoc plugins (buffa messages and views, the
# connect-rust service stubs).
crate.annotation(
    crate = "basable-messenger-gen",
    gen_binaries = ["basable-messenger-gen"],
    # The server's hub only: the core's graph has no codegen binary.
    repositories = ["crates"],
)
crate.annotation(
    crate = "basable-protoc-gen-buffa",
    gen_binaries = ["protoc-gen-buffa"],
    # The server's hub only: the core's graph has no codegen binary.
    repositories = ["crates"],
)
crate.annotation(
    crate = "connectrpc-codegen",
    gen_binaries = ["protoc-gen-connect-rust"],
    # The server's hub only: the core's graph has no codegen binary.
    repositories = ["crates"],
)

# The client core's own hub (core/Cargo.toml says why it is apart): resolved
# for every triple it is built for, so a dependency that does not build for
# wasm or a phone is refused at the pin, not at the first app build.
crate.from_cargo(
    name = "core_crates",
    cargo_lockfile = "//core:Cargo.lock",
    lockfile = "//core:Cargo.Bazel.lock",
    manifests = ["//core:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
        "aarch64-linux-android",
        "x86_64-linux-android",
        "aarch64-apple-ios",
        "aarch64-apple-ios-sim",
    ],
)

# The binding generator's own hub (core/tools/bindgen): uniffi with its
# `cli` feature, which Cargo would otherwise unify into the core's own
# uniffi and so into every phone build. Host only.
# uniffi_bindgen's metadata-only compile and its full compile do not agree
# on the crate hash (the generator fails to link with E0460 under the
# repository's pipelined compilation), so it is compiled once.
crate.annotation(
    crate = "uniffi_bindgen",
    disable_pipelining = True,
    repositories = ["bindgen_crates"],
)
crate.from_cargo(
    name = "bindgen_crates",
    cargo_lockfile = "//core/tools/bindgen:Cargo.lock",
    lockfile = "//core/tools/bindgen:Cargo.Bazel.lock",
    manifests = ["//core/tools/bindgen:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
    ],
)
use_repo(crate, "bindgen_crates", "core_crates", "crates")

# --- buf (lint and breaking checks; codegen is protoc's) --------------------
buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")
buf.toolchains(version = "v1.73.0")
use_repo(buf, "rules_buf_toolchains")

register_toolchains("@rules_buf_toolchains//:all")

# --- The React frontend (rules_js) ------------------------------------------
# The npm graph is frontend/react/pnpm-lock.yaml; `@pnpm` is the pnpm that
# refreshes it (frontend/react/README.md).
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.17.0")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//frontend/react:pnpm-lock.yaml",
)
use_repo(npm, "npm")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
use_repo(pnpm, "pnpm")

# --- Base images (digest-pinned; a tag would move under the project) --------
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

# gcr.io/distroless/cc-debian13:nonroot
oci.pull(
    name = "distroless_cc",
    digest = "sha256:e792ab3d241a468a4fd7519ddbbebe66b49b5f365771716ea688ad40b6c6f1c2",
    image = "gcr.io/distroless/cc-debian13",
    platforms = ["linux/amd64"],
)

# ghcr.io/amacneil/dbmate:2.36.0
oci.pull(
    name = "dbmate",
    digest = "sha256:520c740c6e0ad73fde2cd1ea7e2b779aaf789d22aca8858f87a478e7094535fb",
    image = "ghcr.io/amacneil/dbmate",
    platforms = ["linux/amd64"],
)
use_repo(oci, "dbmate", "dbmate_linux_amd64", "distroless_cc", "distroless_cc_linux_amd64")

# --- The apps (docs/01-deappje/05-deployment.md, "The apps") ----------------
# Loaded here, used nowhere the scaffold's `bazel test //...` reaches: every
# target under ios/ and android/ and every non-host build of core/ is
# incompatible unless --//:apps is set (BUILD.bazel, `//:apps_on`), so the
# server builds with no Xcode and no ANDROID_HOME. apps.yaml is where these
# modules do work.
bazel_dep(name = "apple_support", version = "2.11.0")
bazel_dep(name = "rules_swift", version = "4.2.2")
bazel_dep(name = "rules_apple", version = "5.3.1")
bazel_dep(name = "rules_kotlin", version = "2.4.21")
bazel_dep(name = "rules_android", version = "0.8.0")
bazel_dep(name = "rules_android_ndk", version = "0.1.5")
bazel_dep(name = "rules_jvm_external", version = "7.2")

# The web client's build of the core: wasm32 plus wasm-bindgen's glue. Not
# behind --//:apps: a core that does not compile to wasm fails CI, as the
# plan asks (03-testing.md).
bazel_dep(name = "rules_rust_wasm_bindgen", version = "0.74.0")

# --- android/ ---
# The Android shell (android/, docs/01-deappje/05-deployment.md, "The apps").
# rules_cc is named here so the NDK repository android/ndk.bzl creates, which
# the root module owns, can load `@rules_cc//cc:cc_library.bzl`.
bazel_dep(name = "rules_cc", version = "0.2.14")

# The SDK and the NDK are the machine's, read from ANDROID_HOME and
# ANDROID_NDK_HOME at fetch time (android/README.md); without them both
# repositories are empty and register nothing, which the server's `bazel test
# //...` relies on. Everything under android/ and //core:core_android is behind
# --//:apps.
android_sdk_repository_extension = use_extension("@rules_android//rules/android_sdk_repository:rule.bzl", "android_sdk_repository_extension")
android_sdk_repository_extension.configure(
    api_level = 35,
    build_tools_version = "35.0.0",
)
use_repo(android_sdk_repository_extension, "androidsdk")

register_toolchains("@androidsdk//:sdk-toolchain", "@androidsdk//:all")

# rules_android_ndk's extension fails without an NDK; android/ndk.bzl wraps
# its repository rule and yields an empty repository instead. API 26 is the
# app's minSdkVersion (android/AndroidManifest.xml).
android_ndk = use_extension("//android:ndk.bzl", "android_ndk")
android_ndk.configure(api_level = 26)
use_repo(android_ndk, "androidndk")

register_toolchains("@androidndk//:all")

# The Kotlin toolchain is rules_kotlin's default (Kotlin 2.4.21, registered by
# the module itself); the Compose compiler plugin below is the one built for
# that compiler, and the standard library is the toolchain's: the Maven copy
# is excluded from both graphs so the dex holds exactly one.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

# The app's graph: Compose and Material 3, the lifecycle runtime, Custom Tabs,
# OkHttp, the coroutines the bindings use, and JNA as the AAR that carries
# libjnidispatch.so per ABI. Its own name, since protobuf's module also fills
# a repository called `maven`. Pinned in android/maven_app_install.json
# (`REPIN=1 bazel run @maven_app//:pin` after a change here). AndroidX pins
# exact versions of its own transitives, which Coursier cannot reconcile
# across releases: the versions named here win (`pinned`), so the artifacts
# AndroidX disagrees about are named too.
maven.install(
    name = "maven_app",
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    artifacts = [
        # What the app uses.
        "androidx.activity:activity-compose:1.11.0",
        "androidx.browser:browser:1.9.0",
        "androidx.compose.foundation:foundation:1.9.4",
        "androidx.compose.material3:material3:1.4.0",
        "androidx.compose.runtime:runtime:1.9.4",
        "androidx.compose.ui:ui:1.9.4",
        "androidx.core:core-ktx:1.17.0",
        "androidx.lifecycle:lifecycle-runtime-compose:2.9.4",
        "androidx.lifecycle:lifecycle-viewmodel-compose:2.9.4",
        # The transitives AndroidX's releases pin exactly and differently,
        # each family held at one version.
        "androidx.activity:activity:1.11.0",
        "androidx.activity:activity-ktx:1.11.0",
        "androidx.annotation:annotation:1.9.1",
        "androidx.collection:collection:1.5.0",
        "androidx.collection:collection-ktx:1.5.0",
        "androidx.compose.animation:animation:1.9.4",
        "androidx.compose.animation:animation-core:1.9.4",
        "androidx.compose.foundation:foundation-layout:1.9.4",
        "androidx.compose.material:material-icons-core:1.7.8",
        "androidx.compose.material:material-ripple:1.9.4",
        "androidx.compose.runtime:runtime-saveable:1.9.4",
        "androidx.compose.ui:ui-geometry:1.9.4",
        "androidx.compose.ui:ui-graphics:1.9.4",
        "androidx.compose.ui:ui-text:1.9.4",
        "androidx.compose.ui:ui-unit:1.9.4",
        "androidx.compose.ui:ui-util:1.9.4",
        "androidx.core:core:1.17.0",
        "androidx.lifecycle:lifecycle-common:2.9.4",
        "androidx.lifecycle:lifecycle-runtime:2.9.4",
        "androidx.lifecycle:lifecycle-runtime-ktx:2.9.4",
        "androidx.lifecycle:lifecycle-viewmodel:2.9.4",
        "androidx.lifecycle:lifecycle-viewmodel-ktx:2.9.4",
        "androidx.lifecycle:lifecycle-viewmodel-savedstate:2.9.4",
        "androidx.savedstate:savedstate:1.3.3",
        "androidx.savedstate:savedstate-ktx:1.3.3",
        "com.squareup.okhttp3:okhttp:4.12.0",
        "net.java.dev.jna:jna:aar:5.17.0",
        "org.jetbrains.kotlin:kotlin-compose-compiler-plugin-embeddable:2.4.21",
        "org.jetbrains.kotlinx:kotlinx-coroutines-android:1.10.2",
        "org.jetbrains.kotlinx:kotlinx-coroutines-core-jvm:1.10.2",
    ],
    excluded_artifacts = [
        "org.jetbrains.kotlin:kotlin-stdlib",
        "org.jetbrains.kotlin:kotlin-stdlib-common",
        "org.jetbrains.kotlin:kotlin-stdlib-jdk7",
        "org.jetbrains.kotlin:kotlin-stdlib-jdk8",
    ],
    lock_file = "//android:maven_app_install.json",
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    use_starlark_android_rules = True,
    version_conflict_policy = "pinned",
)

# The host tests' graph (the kt_jvm_tests of android/BUILD.bazel): JNA as the
# plain jar with the desktop libjnidispatch, the coroutines, OkHttp and its
# MockWebServer, JUnit 4. Pinned in android/maven_host_install.json
# (`REPIN=1 bazel run @maven_host//:pin`).
maven.install(
    name = "maven_host",
    artifacts = [
        "com.squareup.okhttp3:mockwebserver:4.12.0",
        "com.squareup.okhttp3:okhttp:4.12.0",
        "junit:junit:4.13.2",
        "net.java.dev.jna:jna:5.17.0",
        "org.jetbrains.kotlinx:kotlinx-coroutines-core-jvm:1.10.2",
    ],
    excluded_artifacts = [
        "org.jetbrains.kotlin:kotlin-stdlib",
        "org.jetbrains.kotlin:kotlin-stdlib-common",
        "org.jetbrains.kotlin:kotlin-stdlib-jdk7",
        "org.jetbrains.kotlin:kotlin-stdlib-jdk8",
    ],
    lock_file = "//android:maven_host_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "maven_app", "maven_host")
