"""The environment an app build talks to, as Kotlin (android/BUILD.bazel).

`//:environment` picks preview or live; the base URL comes from the root
environments.bzl and is never written in Kotlin by hand.
"""

load("//:environments.bzl", "base_url")

def environment_source(environment):
    """The lines of Environment.kt for one environment."""
    return [
        "// Generated by //android:environment_kt from environments.bzl; do not edit.",
        "package com.deappje.android",
        "",
        "/** The deployment this build talks to, chosen at build time by --//:environment. */",
        "object Environment {",
        "    const val NAME: String = \"%s\"" % environment,
        "    const val BASE_URL: String = \"%s\"" % base_url(environment),
        "}",
        "",
    ]
