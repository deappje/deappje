"""The iOS shell's build vocabulary (docs/01-deappje/05-deployment.md, "The
apps"): the compatibility gate every target under ios/ carries, the
generated file that names the environment an app build talks to, the
bridge that hands host-generated files to an iOS build, and the one shape
of an iOS test.
"""

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_apple//apple:ios.bzl", "ios_unit_test")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//:environments.bzl", "base_url")

# Every target under ios/ is built for an iOS platform (rules_apple's rule
# transition puts an ios_application and an ios_unit_test themselves in the
# iOS configuration, not only their deps), and only behind --//:apps: with
# the flag off, `bazel test //...` skips all of it, which is how the
# scaffold's verify.sh and build.yaml stay free of Xcode.
IOS_ONLY = select({
    "//:apps_on": ["@platforms//os:ios"],
    "//conditions:default": ["@platforms//:incompatible"],
})

MINIMUM_OS_VERSION = "17.0"

def _deployment_lines(environment):
    return [
        "// Generated by //ios/application:deployment from environments.bzl for the",
        "// environment //:environment named at build time. Never edit, never",
        "// hard-code a hostname beside it.",
        "",
        "/// The deployment this build talks to.",
        "public enum Deployment {",
        "    /// `preview` or `live`.",
        "    public static let environment = \"%s\"" % environment,
        "    /// The origin, no trailing slash: what `Core` is opened on.",
        "    public static let baseUrl = \"%s\"" % base_url(environment),
        "}",
        "",
    ]

def deployment_swift(name, out):
    """Writes the Swift file naming the environment of this build.

    `preview` by default, `live` under `--//:environment=live` (apps.yaml
    passes it on main).
    """
    write_file(
        name = name,
        out = out,
        content = select({
            "//:environment_live": _deployment_lines("live"),
            "//conditions:default": _deployment_lines("preview"),
        }),
    )

def _host_files_impl(ctx):
    return [DefaultInfo(files = depset(transitive = [src[DefaultInfo].files for src in ctx.attr.srcs]))]

host_files = rule(
    implementation = _host_files_impl,
    attrs = {
        "srcs": attr.label_list(
            allow_files = True,
            # The bindings are generated from a HOST build of the core
            # (core/BUILD.bazel, :bindings_swift); under the iOS transition
            # they would otherwise ask for a host shared library built for
            # iOS. The exec configuration is the host.
            cfg = "exec",
        ),
    },
    doc = "Files generated on the host, as an iOS build's inputs.",
)

def ios_test(name, srcs, deps = [], **kwargs):
    """One iOS unit test: a testonly Swift module and its simulator run.

    The module is named after the target in UpperCamelCase ("device_key"
    becomes DeviceKeyTests). Runs on the simulator the default runner
    picks; `--ios_simulator_device` and `--ios_simulator_version` choose.
    """
    module = "".join([part.capitalize() for part in name.split("_")])
    swift_library(
        name = name + "_lib",
        testonly = True,
        srcs = srcs,
        module_name = module,
        target_compatible_with = IOS_ONLY,
        deps = deps,
    )
    ios_unit_test(
        name = name,
        minimum_os_version = MINIMUM_OS_VERSION,
        target_compatible_with = IOS_ONLY,
        deps = [":" + name + "_lib"],
        **kwargs
    )
