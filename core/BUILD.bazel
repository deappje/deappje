# The client core (docs/01-deappje/01-architecture.md, "The shells"): one
# Rust crate for every device. The host library and its tests build in the
# scaffold's `bazel test //...`; its non-host builds (the apps' libraries,
# the web client's wasm) come with the targets that use them.
load("@core_crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library", "rust_test")
load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen")

# Cargo.toml travels as compile data: uniffi's macros read the crate's
# name from it at compile time.
rust_library(
    name = "core",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = ["Cargo.toml"],
    crate_name = "deappje_core",
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "core_test",
    crate = ":core",
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

# The web client's core: a cdylib built for wasm32 (rust_wasm_bindgen
# transitions it) with wasm-bindgen's JavaScript glue beside it. In the
# scaffold's `bazel test //...` through the frontend; building it is the
# proof that every dependency the core carries has a wasm build.
rust_shared_library(
    name = "core_cdylib",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = ["Cargo.toml"],
    crate_name = "deappje_core",
    # Only for wasm32: on the host it would write the same dylib as :core_host.
    target_compatible_with = ["@platforms//cpu:wasm32"],
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_wasm_bindgen(
    name = "core_wasm",
    target = "web",
    wasm_file = ":core_cdylib",
    visibility = ["//visibility:public"],
)

# The phones' bindings (docs/01-deappje/05-deployment.md, "The apps"): the
# generator reads the exported interface out of a host build of the
# library and writes Swift and Kotlin. Generated on every host build, so
# an export the generator cannot bind fails here, before any app build.
rust_shared_library(
    name = "core_host",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = ["Cargo.toml"],
    crate_name = "deappje_core",
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

genrule(
    name = "bindings_kotlin",
    srcs = [":core_host"],
    outs = ["bindings/kotlin/uniffi/deappje_core/deappje_core.kt"],
    cmd = "$(location //core/tools/bindgen:uniffi-bindgen) generate --library $(location :core_host) --language kotlin --no-format --out-dir $(RULEDIR)/bindings/kotlin",
    tools = ["//core/tools/bindgen:uniffi-bindgen"],
    visibility = ["//visibility:public"],
)

genrule(
    name = "bindings_swift",
    srcs = [":core_host"],
    outs = [
        "bindings/swift/deappje_core.swift",
        "bindings/swift/deappje_coreFFI.h",
        "bindings/swift/deappje_coreFFI.modulemap",
    ],
    cmd = "$(location //core/tools/bindgen:uniffi-bindgen) generate --library $(location :core_host) --language swift --no-format --out-dir $(RULEDIR)/bindings/swift",
    tools = ["//core/tools/bindgen:uniffi-bindgen"],
    visibility = ["//visibility:public"],
)

# --- The Android libraries ---
# The core as the Kotlin bindings load it on a phone (docs/01-deappje/
# 05-deployment.md, "The apps"): a shared library named after the crate,
# `libdeappje_core.so`, which JNA finds by the name the bindings ask for.
# One target serves both ABIs: //android:app builds its deps once per
# platform of --android_platforms (arm64-v8a and x86_64, android/BUILD.bazel)
# and packs each build under lib/<platform>/. Only for Android, and only
# behind --//:apps, so the server's `bazel test //...` never needs the NDK.
rust_shared_library(
    name = "core_android",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = ["Cargo.toml"],
    crate_name = "deappje_core",
    target_compatible_with = ["@platforms//os:android"] + select({
        "//:apps_on": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//android:__subpackages__"],
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

# The host library for the shells' tests (docs/01-deappje/03-testing.md, "App
# shells"): the Kotlin tests put its directory on JNA's library path and load
# it by the crate's name. :core_host itself stays as it is; this is its name
# for android/.
alias(
    name = "core_host_library",
    actual = ":core_host",
    visibility = ["//android:__subpackages__"],
)
