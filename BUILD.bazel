# Root package: the routing topology every generated crate reads, the one
# push target the CI runs (the buf lint gate is //proto:lint), and the flag
# that turns the apps on.
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("@rules_multirun//:defs.bzl", "multirun")

# The apps (docs/01-deappje/05-deployment.md, "The apps"): off by default,
# so `bazel test //...` builds the server, the core's host tests and the web
# client only; `bazel test --//:apps //android/...` and `//ios/...` are the
# app runs (apps.yaml). A target that needs the apps carries
# `target_compatible_with = select({":apps_on": [], "//conditions:default":
# ["@platforms//:incompatible"]})`.
bool_flag(
    name = "apps",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "apps_on",
    flag_values = {":apps": "True"},
    visibility = ["//visibility:public"],
)

# Which environment an app build talks to (environments.bzl): `preview` by
# default, `live` from apps.yaml on main. An app target selects its base URL
# on `:environment_live` / `//conditions:default`.
string_flag(
    name = "environment",
    build_setting_default = "preview",
    values = [
        "preview",
        "live",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "environment_live",
    flag_values = {":environment": "live"},
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "environments.bzl",
        "routing.yaml",
        "Cargo.toml",
        "Cargo.lock",
        "Cargo.Bazel.lock",
    ],
    visibility = ["//visibility:public"],
)

# `bazel run //:push -- --tag <sha>` pushes every image the deployment
# references: the app and the migration image. The frontend is no image: the
# workflow uploads it as the `static` artifact and the platform serves it
# from the environment's public bucket.
multirun(
    name = "push",
    commands = [
        "//app:app_push",
        "//db/app:dbmate_push",
    ],
    visibility = ["//visibility:public"],
)
